{{- $approved := hugo.Data.rss_approvals -}}
{{- $pages := .Pages -}}
{{- if .IsHome }}{{ $pages = site.RegularPages }}{{ end -}}
{{- $items := slice -}}
{{- range $pages -}}
  {{- if and .IsPage .File -}}
    {{- $record := index $approved (replace .File.Path "\\" "/") -}}
    {{- if and $record $record.approved (strings.TrimSpace $record.summary) -}}
      {{- $items = $items | append (dict "page" . "summary" (strings.TrimSpace $record.summary)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if and (gt $limit 0) (gt (len $items) $limit) }}{{ $items = first $limit $items }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n" | safeHTML -}}
<rss version="2.0"><channel>
<title>{{ .Title | transform.XMLEscape | safeHTML }}</title>
<link>{{ .Permalink | transform.XMLEscape | safeHTML }}</link>
<description>Approved Digital Garden updates</description>
{{- range $items }}
<item>
<title>{{ .page.Title | transform.XMLEscape | safeHTML }}</title>
<link>{{ .page.Permalink | transform.XMLEscape | safeHTML }}</link>
<guid>{{ .page.Permalink | transform.XMLEscape | safeHTML }}</guid>
<pubDate>{{ .page.Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
<description>{{ .summary | transform.XMLEscape | safeHTML }}</description>
</item>
{{- end }}
</channel></rss>
